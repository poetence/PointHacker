datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProgramType {
  BANK_TRANSFERABLE
  AIRLINE
  HOTEL
  CASHBACK
  OTHER
}

enum Region {
  NORTH_AMERICA
  SOUTH_AMERICA
  EUROPE
  ASIA
  AFRICA
  OCEANIA
  MIDDLE_EAST
  CARIBBEAN
}

enum AwardCabin {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

enum AwardGoalKind {
  FLIGHT
  HOTEL
}

/// Rough property tier — maps onto each hotel program's own category/award bands
enum HotelTier {
  STANDARD
  UPSCALE
  LUXURY
}

/// Reference/seed data — a loyalty currency (Amex MR, Delta SkyMiles, Hyatt, ...)
model RewardsProgram {
  id                          String      @id @default(cuid())
  name                        String      @unique
  shortName                   String?
  type                        ProgramType
  defaultRedemptionValueCents Decimal     @db.Decimal(6, 3)
  regions                     Region[]    @default([])
  /// Months of inactivity before points expire; null means never expires / no known policy
  pointsExpirationMonths      Int?
  /// What the program calls its currency unit: "points" or "miles"
  pointsUnit                  String      @default("points")
  notes                       String?
  isActive                    Boolean     @default(true)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  creditCards    CreditCard[]
  pointsBalances PointsBalance[]
  cardProducts   CardProduct[]
  awardCosts     AwardCost[]
  hotelAwardCosts HotelAwardCost[]
  transfersFrom  TransferPartner[] @relation("TransferFrom")
  transfersTo    TransferPartner[] @relation("TransferTo")
}

/// Reference/seed data — a ballpark one-way, per-person award price for flying
/// from North America to a region in a given cabin, in the program's own currency
model AwardCost {
  id               String         @id @default(cuid())
  rewardsProgramId String
  rewardsProgram   RewardsProgram @relation(fields: [rewardsProgramId], references: [id])
  region           Region
  cabin            AwardCabin
  pointsOneWay     Int
  notes            String?

  @@unique([rewardsProgramId, region, cabin])
  @@index([region, cabin])
}

/// Reference/seed data — a ballpark per-night, per-room award price for a hotel
/// program's properties of a given tier in a region, in the program's own currency
model HotelAwardCost {
  id               String         @id @default(cuid())
  rewardsProgramId String
  rewardsProgram   RewardsProgram @relation(fields: [rewardsProgramId], references: [id])
  region           Region
  tier             HotelTier
  pointsPerNight   Int
  notes            String?

  @@unique([rewardsProgramId, region, tier])
  @@index([region, tier])
}

/// User data — a trip the user is saving points toward. FLIGHT goals use
/// cabin/travelers/roundTrip; HOTEL goals use hotelTier/nights/rooms.
model AwardGoal {
  id         String        @id @default(cuid())
  userId     String
  /// Free-text destination ("Tokyo"); region is what the estimate actually keys on
  label      String
  kind       AwardGoalKind @default(FLIGHT)
  region     Region
  cabin      AwardCabin    @default(ECONOMY)
  travelers  Int           @default(1)
  roundTrip  Boolean       @default(true)
  hotelTier  HotelTier     @default(UPSCALE)
  nights     Int           @default(1)
  rooms      Int           @default(1)
  /// Two-letter US state the flight departs from; null means "somewhere in the US" (no adjustment)
  originState String?
  /// First of the month the user wants to travel, if known
  targetMonth DateTime?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

/// Reference/seed data — a transfer relationship between two programs
model TransferPartner {
  id                            String         @id @default(cuid())
  fromProgramId                 String
  fromProgram                   RewardsProgram @relation("TransferFrom", fields: [fromProgramId], references: [id])
  toProgramId                   String
  toProgram                     RewardsProgram @relation("TransferTo", fields: [toProgramId], references: [id])
  ratioFrom                     Int            @default(1)
  ratioTo                       Int            @default(1)
  minimumTransfer               Int?
  transferFeeCents              Int?
  estimatedRedemptionValueCents Decimal?       @db.Decimal(6, 3)
  notes                         String?
  isActive                      Boolean        @default(true)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  bonuses TransferBonus[]

  @@unique([fromProgramId, toProgramId])
  @@index([fromProgramId])
}

/// Shared data — a time-boxed promo that boosts a transfer ratio (e.g. +30% for a month)
model TransferBonus {
  id                String          @id @default(cuid())
  transferPartnerId String
  transferPartner   TransferPartner @relation(fields: [transferPartnerId], references: [id], onDelete: Cascade)
  bonusPercent      Int
  startsOn          DateTime
  endsOn            DateTime
  notes             String?
  createdAt         DateTime        @default(now())

  @@index([transferPartnerId, endsOn])
}

/// A person who can sign in
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

/// An OAuth account linked to a User
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Required by the Prisma adapter's type surface; unused at runtime since sessions are JWTs
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// User data — a physical/virtual credit card
model CreditCard {
  id               String         @id @default(cuid())
  userId           String
  issuer           String
  productName      String
  nickname         String?
  rewardsProgramId String
  rewardsProgram   RewardsProgram @relation(fields: [rewardsProgramId], references: [id])
  /// Set when the card was picked from the catalog; null for custom/free-text cards
  cardProductId    String?
  cardProduct      CardProduct?   @relation(fields: [cardProductId], references: [id], onDelete: SetNull)
  annualFeeCents   Int?
  openedOn         DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([rewardsProgramId])
}

/// User data — pooled balance for one program
model PointsBalance {
  id                String         @id @default(cuid())
  userId            String
  rewardsProgramId  String
  rewardsProgram    RewardsProgram @relation(fields: [rewardsProgramId], references: [id])
  balance           Int            @default(0)
  lastUpdatedAt     DateTime       @default(now())
  /// Manual override for a fixed expiration date, when known, instead of the program's inactivity policy
  expiresOverrideAt DateTime?
  notes             String?

  snapshots BalanceSnapshot[]

  @@unique([userId, rewardsProgramId])
}

/// User data — a point-in-time record of a balance, written on every balance change
model BalanceSnapshot {
  id              String        @id @default(cuid())
  pointsBalanceId String
  pointsBalance   PointsBalance @relation(fields: [pointsBalanceId], references: [id], onDelete: Cascade)
  balance         Int
  recordedAt      DateTime      @default(now())

  @@index([pointsBalanceId, recordedAt])
}

/// Reference/seed data — a credit card product and what it earns
model CardProduct {
  id                     String         @id @default(cuid())
  issuer                 String
  name                   String
  rewardsProgramId       String
  rewardsProgram         RewardsProgram @relation(fields: [rewardsProgramId], references: [id])
  annualFeeCents         Int            @default(0)
  welcomeBonusPoints     Int?
  welcomeBonusSpendCents Int?
  welcomeBonusMonths     Int?
  /// Points per dollar on anything not in earnRates
  baseEarnRate           Decimal        @db.Decimal(4, 2)
  /// { DINING: 4, GROCERIES: 4, ... } overrides keyed by SpendCategory
  earnRates              Json           @default("{}")
  notes                  String?
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  creditCards CreditCard[]

  @@unique([issuer, name])
}

/// User data — monthly spend by category + preferences, one per user
model SpendingProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  diningCents       Int      @default(0)
  groceriesCents    Int      @default(0)
  travelCents       Int      @default(0)
  gasCents          Int      @default(0)
  transitCents      Int      @default(0)
  onlineCents       Int      @default(0)
  otherCents        Int      @default(0)
  /// "ANY" | "TRAVEL" | "CASHBACK"
  rewardsPreference String   @default("ANY")
  maxAnnualFeeCents Int?
  updatedAt         DateTime @updatedAt
}
